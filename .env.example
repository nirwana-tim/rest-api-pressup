SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
JWT_SECRET=a_very_long_and_random_string_for_jwt_secret
JWT_EXPIRES_IN=10d
SUPABASE_AUDIO_BUCKET=session-audios
MAX_AUDIO_DURATION_SECONDS=900

# AI API Keys (Supports key rotation: separate multiple keys with a comma)
ASSEMBLYAI_API_KEYS=your_assemblyai_api_key_1,your_assemblyai_api_key_2
GROQ_API_KEY=your_groq_api_key_1,your_groq_api_key_2

# Schedule reminder email
BREVO_API_KEY=your_brevo_api_key
REMINDER_EMAIL_FROM=noreply@your-domain.com
REMINDER_EMAIL_FROM_NAME=Press Up
CRON_SECRET=your_random_cron_secret
INTERNAL_API_BASE_URL=http://127.0.0.1:3000
